{% comment %}
  Renders the gift-wrap option: a checkbox row with the stock status beside it, and the recipient and
  message fields that open when the box is ticked. The inputs belong to the product form through the
  form attribute, so the choice is added to the cart as line item properties alongside the product.

  Accepts:
  - block: {Object} the gift_wrap block, carries the stock status settings. The character limits are theme settings.
  - product: {Object} product object.
  - product_form_id: {String} id of the product form the inputs submit with.
  - section_id: {String} id of the section to which this snippet belongs.

  Usage:
  {% render 'gift-wrap', block: block, product: product, product_form_id: product_form_id, section_id: section.id %}
{% endcomment %}
{{ 'tailwind.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-wrap.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign fields_id = 'GiftWrapFields-' | append: section_id
  assign to_id = 'GiftTo-' | append: section_id
  assign from_id = 'GiftFrom-' | append: section_id
  assign message_id = 'GiftMessage-' | append: section_id

  assign wrap_property = 'products.product.gift_wrap.wrap_property' | t | escape_once
  assign wrap_value = 'products.product.gift_wrap.wrap_value' | t | escape_once
  assign wrap_label = 'products.product.gift_wrap.label' | t
  assign wrap_input_name = 'properties[' | append: wrap_property | append: ']'
  assign to_label = 'products.product.gift_wrap.to_label' | t
  assign to_property = 'products.product.gift_wrap.to_property' | t
  assign to_placeholder = 'products.product.gift_wrap.to_placeholder' | t
  assign from_label = 'products.product.gift_wrap.from_label' | t
  assign from_property = 'products.product.gift_wrap.from_property' | t
  assign from_placeholder = 'products.product.gift_wrap.from_placeholder' | t
  assign message_label = 'products.product.gift_wrap.message_label' | t
  assign message_property = 'products.product.gift_wrap.message_property' | t
  assign message_placeholder = 'products.product.gift_wrap.message_placeholder' | t
-%}

<gift-wrap {{ block.shopify_attributes }}>
  <div class="tw-flex tw-items-center tw-justify-between tw-gap-4">
    {%- render 'gift-wrap-checkbox',
      label: wrap_label,
      name: wrap_input_name,
      value: wrap_value,
      form: product_form_id,
      controls_id: fields_id
    -%}

    {%- if block.settings.show_inventory -%}
      {%- render 'inventory-status',
        product: product,
        section_id: section_id,
        inventory_threshold: block.settings.inventory_threshold,
        show_inventory_quantity: block.settings.show_inventory_quantity
      -%}
    {%- endif -%}
  </div>

  <fieldset id="{{ fields_id }}" class="tw-m-0 tw-min-w-0 tw-border-0 tw-p-0" data-gift-wrap-fields hidden disabled>
    <legend class="visually-hidden">{{ 'products.product.gift_wrap.fields_legend' | t }}</legend>
    <div class="tw-mt-4 tw-flex tw-flex-col tw-gap-4">
      {%- render 'gift-wrap-field',
        id: to_id,
        label: to_label,
        name: to_property,
        placeholder: to_placeholder,
        max_length: settings.gift_wrap_to_max_length,
        product_form_id: product_form_id
      -%}
      {%- render 'gift-wrap-field',
        id: from_id,
        label: from_label,
        name: from_property,
        placeholder: from_placeholder,
        max_length: settings.gift_wrap_from_max_length,
        product_form_id: product_form_id
      -%}
      {%- render 'gift-wrap-field',
        id: message_id,
        label: message_label,
        name: message_property,
        placeholder: message_placeholder,
        max_length: settings.gift_wrap_message_max_length,
        product_form_id: product_form_id,
        multiline: true
      -%}
    </div>
  </fieldset>
</gift-wrap>
